# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Chat model backend --------------------------------------------------
# Two providers, in priority order:
#   1. openai  ChatGPT subscription through Codex OAuth (no OPENAI_API_KEY).
#              Sign in once: uv run python -m pilot_kit.chatgpt_login
#   2. nim     NVIDIA NIM. Get a key at https://build.nvidia.com
# Leave LLM_PROVIDER unset to use the first configured one.
LLM_PROVIDER=nim
# Optional. Defaults: openai -> gpt-5.5, nim -> nvidia/nemotron-3.5-lightning-30b-a3b
# Find models your ChatGPT account can use: uv run python -m pilot_kit.chatgpt_models
# LLM_MODEL=
# Seconds. Hosted NIM can take over a minute per call. Defaults to 180.
# LLM_TIMEOUT=180
# NIM reasoning models sometimes put their thinking in the reply. false turns thinking off.
# LLM_ENABLE_THINKING=false

# NVIDIA NIM (LLM_PROVIDER=nim)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Leave unset for the hosted API catalog. Self-hosted NIM example:
# NVIDIA_BASE_URL=http://0.0.0.0:8000/v1

# --- Your product's key goes here ----------------------------------------
# PRODUCT_API_KEY=

# --- LangSmith tracing (optional, useful with LangGraph Studio) ----------
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=template-pilot-python
